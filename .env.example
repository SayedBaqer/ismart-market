# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ismart_market"

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32_CHAR_STRING"
NEXTAUTH_URL="http://localhost:3000"

# ── File uploads — choose ONE option ──────────────────────────────────────
#
# OPTION A: Cloudflare R2 (recommended — 10 GB free, ZERO bandwidth cost)
# Get from: cloudflare.com → R2 → Create bucket → Manage API tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="ismart"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
#
# OPTION B: Cloudinary (25 GB/month free)
# Get from: cloudinary.com → Dashboard → "API environment variable"
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ── Optional: Redis (rate limiting + cache) ────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ── Optional: Email ────────────────────────────────────────────────────────
# RESEND_API_KEY=""

# ── Optional: Zoho Books ───────────────────────────────────────────────────
# ZOHO_CLIENT_ID=""
# ZOHO_CLIENT_SECRET=""
# ZOHO_REFRESH_TOKEN=""

# ── Optional: Instagram post preview (shop Instagram import picker) ────────
# Needed for the "Preview & Select" step in Shop > Instagram Import to show
# real thumbnails/captions. Provide EITHER a direct token OR a Facebook App
# ID+Secret pair (used as an app access token). Without either, the import
# flow still works but skips preview images (owner adds images manually).
# INSTAGRAM_OEMBED_ACCESS_TOKEN=""
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="iSmart Market"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_CURRENCY="BHD"
