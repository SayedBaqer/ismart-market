# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ismart_market"

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32_CHAR_STRING"
NEXTAUTH_URL="http://localhost:3000"

# ── File uploads — Cloudinary (free 25 GB/month) ──────────────────────────
# Get from: https://cloudinary.com → Dashboard → "API environment variable"
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ── Optional: Redis (rate limiting + cache) ────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ── Optional: Email ────────────────────────────────────────────────────────
# RESEND_API_KEY=""

# ── Optional: Zoho Books ───────────────────────────────────────────────────
# ZOHO_CLIENT_ID=""
# ZOHO_CLIENT_SECRET=""
# ZOHO_REFRESH_TOKEN=""

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="iSmart Market"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_CURRENCY="BHD"
